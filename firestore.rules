rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User cloud files
    match /files/{fileId} {
      allow read, write: if true;
    }

    // Permanent shared Python code snippets
    match /shared_snippets/{snippetId} {
      allow read: if true;
      allow create: if request.resource.data.code is string 
                    && request.resource.data.code.size() <= 100000
                    && request.resource.data.id == snippetId;
      allow update, delete: if false;
    }

    // Real-time community chat messages
    match /chat_messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
