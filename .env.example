# AI Provider Keys (set at least ONE in your local .env, Cloud Run, or Cloudflare Pages Variables & Secrets)
# Primary: DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Optional / fallback AI providers:
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SERVER_URL: Optional external backend URL (leave unset on Cloudflare Pages so built-in /functions/api handles requests at the edge).
