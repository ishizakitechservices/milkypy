{
  "entities": {
    "CloudFile": {
      "title": "CloudFile",
      "description": "User Python source file saved in the cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "code", "updatedAt"]
    },
    "SharedSnippet": {
      "title": "SharedSnippet",
      "description": "Public permanent shared Python code snippet generated by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "code": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "number" },
        "author": { "type": "string" }
      },
      "required": ["id", "code", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time chat message sent by students in community channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "channel": { "type": "string" },
        "codeSnippet": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "content", "channel", "createdAt"]
    }
  },
  "firestore": {
    "/files/{fileId}": {
      "schema": "CloudFile",
      "description": "User saved files"
    },
    "/shared_snippets/{snippetId}": {
      "schema": "SharedSnippet",
      "description": "Permanent public shared Python code snippets"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time shared community chat messages"
    }
  }
}
